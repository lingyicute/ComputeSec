import{CustomElement}from"chrome://resources/js/custom_element.js";import{getTemplate}from"./expandable_list_item.html.js";export class ExpandableListItemElement extends CustomElement{static get template(){return getTemplate()}connectedCallback(){const briefContent=this.shadowRoot.querySelector(".brief-content");briefContent.addEventListener("click",(()=>this.onExpand_()));this.classList.add("expandable-list-item")}onExpand_(){const expanded=!this.hasAttribute("expanded");this.toggleAttribute("expanded",expanded);this.dispatchEvent(new CustomEvent("list-item-expanded",{bubbles:true,composed:true,detail:expanded}))}}customElements.define("expandable-list-item",ExpandableListItemElement);
