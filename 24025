import{CustomElement}from"chrome://resources/js/custom_element.js";import{getTemplate}from"./mojo_timestamp.html.js";class MojoTimestampElement extends CustomElement{static observedAttributes=["ts"];static get template(){return getTemplate()}mojoTsToJsDate(mojoTs){const windowsEpoch=Date.UTC(1601,0,1,0,0,0,0);const unixEpoch=Date.UTC(1970,0,1,0,0,0,0);const epochDeltaInMs=unixEpoch-windowsEpoch;const timeInMs=Number(mojoTs)/1e3;return new Date(timeInMs-epochDeltaInMs)}attributeChangedCallback(name,_oldValue,newValue){if(name==="ts"){const elem=this.shadowRoot.querySelector("#time");const ts=BigInt(newValue);if(ts===BigInt(0)){elem.textContent="epoch";elem.classList.add("none")}else{const date=this.mojoTsToJsDate(ts);elem.textContent=date.toUTCString();elem.classList.remove("none")}}}}customElements.define("mojo-timestamp",MojoTimestampElement);
