import{html}from"//resources/lit/v3_0/lit.rollup.js";const CHECKMARK_HTML=html`<span class="green">&#10004;</span>`;const CROSSMARK_HTML=html`<span class="red">&#10006;</span>`;export function getHtml(){return html`
  <button @click="${this.refreshDetails_}">Refresh eligibility details</button>
  <ul>
    <li><b>Country</b>: ${this.country_}</li>
    <li><b>Locale</b>: ${this.locale_}</li>
    ${this.details_.map((detail=>html`
      <li>
        <b>${detail.name}</b>: ${detail.value}
        ${detail.value===detail.expectedValue?CHECKMARK_HTML:CROSSMARK_HTML}
      </li>`))}
  </ul>`}
