;faviconUrl.searchParams.set("allowGoogleServerFallback",fallback);if(isSyncedUrlForHistoryUi){faviconUrl.searchParams.set("iconUrl",remoteIconUrlForUma)}if(forceLightMode){faviconUrl.searchParams.set("forceLightMode","true")}return getImageSet(faviconUrl.toString())}
