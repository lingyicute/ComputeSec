<cr-dialog id="dialog" close-text="${this.i18n("close")}" show-on-attach>
  <div slot="title">
    <cr-icon icon="cr:domain" role="img"
        aria-label="${this.i18n("controlledSettingPolicy")}">
    </cr-icon>
    ${this.title}
