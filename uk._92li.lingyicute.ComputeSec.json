{
    "id": "uk._92li.lingyicute.ComputeSec",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "computesec",
    "finish-args": [
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--system-talk-name=org.freedesktop.fwupd",
        "--system-talk-name=org.freedesktop.hostname1",
        "--filesystem=/var/lib/flatpak:ro",
        "--filesystem=~/.local/share/flatpak:ro",
        "--filesystem=/run/udev:ro",
        "--filesystem=/boot:ro",
        "--filesystem=/efi:ro"
    ],
    "//": "Permissions justification:",
    "//-fwupd": "Read HSI via D-Bus org.freedesktop.fwupd (read-only)",
    "//-hostname1": "Read host OS pretty name, kernel, hw vendor/model via systemd-hostnamed",
    "//-network": "Fetch the current mainline/stable kernel version from kernel.org (releases.json) to tell whether the running kernel is supported; also makes /proc/sys/net the host view instead of a private netns",
    "//-flatpak-ro": "Count installed Flatpak apps to evaluate sandbox adoption - read-only",
    "//-udev": "Enumerate USB devices from /run/udev to detect 2.4G wireless receivers",
    "//-boot": "Detect the Windows boot loader at /boot/efi, /boot/EFI (covers every ESP mount layout under /boot) - read-only",
    "//-efi": "Detect the Windows boot loader when the ESP is mounted at /efi - read-only",
    "cleanup": [
        "*.pyc",
        "__pycache__"
    ],
    "modules": [
        {
            "name": "computesec",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/lib/computesec",
                "cp -r computesec /app/lib/computesec/",
                "cp -r data /app/lib/computesec/",
                "install -Dm755 run.py /app/bin/computesec",
                "install -Dm644 data/uk._92li.lingyicute.ComputeSec.desktop /app/share/applications/uk._92li.lingyicute.ComputeSec.desktop",
                "install -Dm644 data/uk._92li.lingyicute.ComputeSec.metainfo.xml /app/share/metainfo/uk._92li.lingyicute.ComputeSec.metainfo.xml",
                "install -Dm644 data/icons/hicolor/scalable/apps/uk._92li.lingyicute.ComputeSec.svg /app/share/icons/hicolor/scalable/apps/uk._92li.lingyicute.ComputeSec.svg"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": ".",
                    "skip": [
                        ".git",
                        ".flatpak-builder",
                        "build-dir",
                        "repo",
                        "*.flatpak",
                        "web"
                    ]
                }
            ]
        }
    ]
}
