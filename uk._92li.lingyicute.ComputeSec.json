{
  "id": "uk._92li.lingyicute.ComputeSec",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "computesec",
  "finish-args": [
    "--socket=wayland",
    "--device=dri",
    "--system-talk-name=org.freedesktop.fwupd",
    "--system-talk-name=org.freedesktop.hostname1",
    "--filesystem=/var/lib/flatpak:ro",
    "--filesystem=~/.local/share/flatpak:ro",
    "--filesystem=/run/udev:ro",
    "--filesystem=/boot/efi:ro",
    "--filesystem=/efi:ro"
  ],
  "cleanup": [
    "*.pyc",
    "__pycache__"
  ],
  "modules": [
    {
      "name": "computesec",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/computesec",
        "cp -r computesec /app/lib/computesec/",
        "cp -r data /app/lib/computesec/",
        "install -Dm755 run.py /app/bin/computesec",
        "install -Dm644 data/uk._92li.lingyicute.ComputeSec.desktop /app/share/applications/uk._92li.lingyicute.ComputeSec.desktop",
        "install -Dm644 data/uk._92li.lingyicute.ComputeSec.metainfo.xml /app/share/metainfo/uk._92li.lingyicute.ComputeSec.metainfo.xml",
        "install -Dm644 data/icons/hicolor/scalable/apps/uk._92li.lingyicute.ComputeSec.svg /app/share/icons/hicolor/scalable/apps/uk._92li.lingyicute.ComputeSec.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": ".",
          "skip": [".git", ".flatpak-builder", "build-dir", "repo", "*.flatpak", "index.html"]
        }
      ]
    }
  ]
}
